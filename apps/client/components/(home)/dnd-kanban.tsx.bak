"use client";

import { useMemo } from "react";

import {
  Kanban,
  KanbanBoard,
  KanbanColumn,
  KanbanColumnContent,
  KanbanColumnHandle,
  KanbanItem,
  KanbanItemHandle,
  KanbanOverlay,
} from "@/components/reui/kanban"

import { taskService } from "@/services/task.service";
import { useQuery } from "@tanstack/react-query";

import type { Task } from "@/types/task.type";

type TaskStatus = Task["status"];

export default function DndKanban() {
  const { data: tasks, isPending, error } = useQuery<Task[], Error>({
    queryKey: ["tasks"],
    queryFn: async () => {
      const tasks = await taskService.getMyTasks();
      return tasks;
    },
  });


  const groupedTasks = useMemo(() => {
    const grouped: Record<TaskStatus, Partial<Task>[]> = {
      to_do: [],
      in_progress: [],
      done: [],
    };

    for (const task of tasks ?? []) {
      grouped[task.status].push(task);
    }
    return grouped;
  }, [tasks]);


  if (isPending) {
    return <div>Loading...</div>;
  }

  if (error) {
    return <div>Error: {error.message}</div>;
  }

  return (
    <Kanban
      value={groupedTasks}
      onValueChange={(newTasks) => {
        console.log("New tasks:", newTasks);
      }}
      getItemValue={(item) => String(item.id)}
    >
      <KanbanBoard>
    {Object.entries({
      "to_do": "To Do",
      "in_progress": "In Progress",
      "done": "Done",
    }).map(([key, text]) => (
      <KanbanColumn key={key} value={key}>
        <KanbanColumnHandle>
          <h3>{key}</h3>
        </KanbanColumnHandle>
        <KanbanColumnContent value={key}>
          <h3 className="text-lg font-semibold mb-2">{text}</h3>
          {tasks
            .filter((task) => task.status === key)
            .map((task) => (
              <KanbanItem key={task.id} value={task.id.toString(/** TODO */)}>
                <KanbanItemHandle> {task.title} </KanbanItemHandle>
                <div className="p-2 border rounded bg-white shadow">
                  <h4 className="font-semibold">{task.title}</h4>
                  <p>{task.description}</p>
                </div>
              </KanbanItem>
            ))}
        </KanbanColumnContent>
        <KanbanOverlay />
      </KanbanColumn>
    ))}
    </KanbanBoard>
    </Kanban>
  );
}