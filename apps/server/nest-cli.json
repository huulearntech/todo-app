{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.json",
    "watchAssets": false
  },
  "watchOptions": {
    "watch": ["src/**/*", "../../packages/shared/src/**/*"],
    "ignored": ["**/node_modules", "**/dist", "**/*.d.ts", "**/*.js", "**/*.js.map"]
  }
}
