NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_db
FRONTEND_URL=http://localhost:3000

JWT_SECRET=your_jwt_access_secret_key_here
JWT_SECRET_EXPIRATION_SECONDS=900
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_REFRESH_SECRET_EXPIRATION_SECONDS=604800

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Redis Service (Required for BullMQ queues and reminders)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Mailer Service (Required in production)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
